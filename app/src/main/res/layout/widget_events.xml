<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="Kalendarz Wydarzeń" android:textColor="#FF8A5B" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/mode" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#8A93A8" android:textSize="11sp" />
    </LinearLayout>
    <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="16dp" android:text="Brak nadchodzących wydarzeń" android:textColor="#8A93A8" android:textSize="13sp" />
    <LinearLayout android:id="@+id/r0" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingTop="7dp" android:paddingBottom="2dp" android:visibility="gone">
        <TextView android:id="@+id/c0" android:layout_width="4dp" android:layout_height="match_parent" android:background="#FF8A5B" />
        <TextView android:id="@+id/t0" android:layout_width="62dp" android:layout_height="wrap_content" android:paddingStart="8dp"
            android:textColor="#E8EBF2" android:textSize="12sp" android:textStyle="bold" android:maxLines="2" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/n0" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#FFFFFF" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/l0" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#AEB6C8" android:textSize="11.5sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/r1" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingTop="7dp" android:paddingBottom="2dp" android:visibility="gone">
        <TextView android:id="@+id/c1" android:layout_width="4dp" android:layout_height="match_parent" android:background="#FF8A5B" />
        <TextView android:id="@+id/t1" android:layout_width="62dp" android:layout_height="wrap_content" android:paddingStart="8dp"
            android:textColor="#E8EBF2" android:textSize="12sp" android:textStyle="bold" android:maxLines="2" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/n1" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#FFFFFF" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/l1" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#AEB6C8" android:textSize="11.5sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/r2" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingTop="7dp" android:paddingBottom="2dp" android:visibility="gone">
        <TextView android:id="@+id/c2" android:layout_width="4dp" android:layout_height="match_parent" android:background="#FF8A5B" />
        <TextView android:id="@+id/t2" android:layout_width="62dp" android:layout_height="wrap_content" android:paddingStart="8dp"
            android:textColor="#E8EBF2" android:textSize="12sp" android:textStyle="bold" android:maxLines="2" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/n2" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#FFFFFF" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/l2" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#AEB6C8" android:textSize="11.5sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/r3" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingTop="7dp" android:paddingBottom="2dp" android:visibility="gone">
        <TextView android:id="@+id/c3" android:layout_width="4dp" android:layout_height="match_parent" android:background="#FF8A5B" />
        <TextView android:id="@+id/t3" android:layout_width="62dp" android:layout_height="wrap_content" android:paddingStart="8dp"
            android:textColor="#E8EBF2" android:textSize="12sp" android:textStyle="bold" android:maxLines="2" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/n3" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#FFFFFF" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/l3" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#AEB6C8" android:textSize="11.5sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
